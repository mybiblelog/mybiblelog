{
  "name": "my-bible-log",
  "main": "expo-router/entry",
  "version": "1.0.2",
  "private": true,
  "scripts": {
    "start": "expo start",
    "start:dev": "EXPO_PUBLIC_API_BASE_URL=http://localhost:8080 expo start",
    "start:staging": "EXPO_PUBLIC_API_BASE_URL=https://staging.example.com expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "generate:assets": "node ./scripts/generate-brand-assets.mjs",
    "android": "expo run:android --device",
    "android:fresh": "adb uninstall com.mybiblelog.app; expo run:android --device",
    "ios": "expo run:ios",
    "web": "EXPO_PUBLIC_API_BASE_URL=http://localhost:8080 expo start --web",
    "lint": "expo lint",
    "format": "prettier --write \"{src,app}/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"{src,app}/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:scripts": "node --test $(find scripts -name '*.test.mjs')",
    "e2e": "node scripts/e2e/run.mjs",
    "e2e:smoke": "node scripts/e2e/run.mjs --include-tags smoke",
    "e2e:seed": "node scripts/e2e/seed.mjs",
    "check:build-env": "node scripts/check-build-env.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "play:validate": "node scripts/play/validate.mjs",
    "play:graphics": "node scripts/play/render-graphics.mjs",
    "play:listing:diff": "node --env-file-if-exists=.env scripts/play/push.mjs --dry-run",
    "play:listing:push": "node --env-file-if-exists=.env scripts/play/push.mjs",
    "eas:build:android:dev": "node scripts/check-build-env.mjs --profile development && eas build --platform android --profile development",
    "eas:build:android:preview": "node scripts/check-build-env.mjs --profile preview && eas build --platform android --profile preview",
    "eas:build:android:production": "node scripts/check-build-env.mjs --profile production && eas build --platform android --profile production",
    "eas:build:android:production:submit": "node scripts/check-build-env.mjs --profile production && eas build --platform android --profile production --auto-submit",
    "eas:submit:android": "eas submit --platform android --profile production --latest",
    "eas-build-pre-install": "node scripts/check-build-env.mjs --assert && npm --prefix ../shared install",
    "clean": "rm -rf node_modules .expo .expo-shared .turbo dist build coverage android ios"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.0.3",
    "@mybiblelog/shared": "file:../shared",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "~8.28.0",
    "dayjs": "^1.11.13",
    "expo": "^58.0.19",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.18",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.15",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-store-review": "~58.0.2",
    "expo-system-ui": "~58.0.6",
    "i18n-js": "^4.5.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-nitro-google-signin": "^0.7.2",
    "react-native-nitro-modules": "^0.35.10",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "@react-native/jest-preset": "0.88.0"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.2.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.13",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "google-auth-library": "^10.6.0",
    "jest": "^29.7.0",
    "jest-expo": "~58.0.12",
    "prettier": "^3.9.4",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  }
}
