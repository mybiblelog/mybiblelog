# Copy to .env (`cp .env.example .env`). Both /api and /web read the root .env.
# These values run the app, the API tests, and the e2e suite locally against
# docker-compose.yml's MongoDB. CI uses this file as-is.

# Base site URL: canonical links, absolute links in emails
SITE_URL=http://localhost:3000

# Express API port, and where Nuxt proxies /api/* requests (defaults shown)
API_PORT=8080
API_BASE_URL=http://localhost:8080

# Matches docker-compose.yml
MONGODB_URI=mongodb://root:examplepassword@localhost:27017

# Only enforced when NODE_ENV=production; must be 10+ characters
JWT_SECRET=dev-jwt-secret

# Defaults to true when unset. UI registration in the e2e suite and the
# live-server API tests need false.
REQUIRE_EMAIL_VERIFICATION=false

# Email sending. Outside production, emails are recorded instead of sent, so
# placeholders work unless you're testing real delivery.
EMAIL_SENDING_DOMAIN=example.com
EMAIL_UNSUBSCRIBE_ADDRESS=unsubscribe@example.com
RESEND_API_KEY=re_placeholder

# Google OAuth2, only needed for Google login (see docs/oauth.md)
GOOGLE_CLIENT_ID=placeholder.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=placeholder
GOOGLE_REDIRECT=http://localhost:3000/google-login
# Comma-separated extra client IDs accepted as the audience of a native-mobile
# id_token (iOS / Android / web). GOOGLE_CLIENT_ID is always allowed.
GOOGLE_ALLOWED_CLIENT_IDS=

# Tests. TEST_BYPASS_SECRET skips email verification and rate limits on auth
# endpoints; it is never honored when NODE_ENV=production.
TEST_SITE_URL=http://localhost:3000
TEST_API_URL=http://localhost:8080
TEST_BYPASS_SECRET=dev-test-bypass-secret

# Optional
# GA_MEASUREMENT_ID=G-xxxxxxxxxx       # Google Analytics
# OPENAI_API_KEY=xxxxxxxxxx            # scripted <i18n> block translations
# SCREENSHOT_HEADLESS=false            # screenshot script
# SCREENSHOT_EMAIL=demo@example.com
# SCREENSHOT_PASSWORD=password
