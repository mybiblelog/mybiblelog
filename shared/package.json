{
  "name": "@mybiblelog/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shared utilities for My Bible Log",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./platform/date-helpers.ts",
    "./dist/platform/date-helpers.js"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf node_modules dist",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "npm run build"
  },
  "keywords": [
    "bible",
    "utilities",
    "shared"
  ],
  "author": "Aaron Smith",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "dayjs": "^1.11.13",
    "typescript": "~6.0.3"
  }
}
